rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isShortString(v) {
      return v is string && v.size() > 0 && v.size() <= 200;
    }

    function validNivel(n) {
      return n in ['nunca_usei', 'perguntas_simples', 'produzo_conteudo', 'ja_criei'];
    }

    function validNewParticipant(data) {
      return data.keys().hasAll(['nome', 'orgao', 'email', 'nivel', 'quer_grupo_whatsapp', 'criado_em', 'consentimento_lgpd'])
          && data.keys().hasOnly(['nome', 'orgao', 'email', 'whatsapp', 'nivel', 'quer_grupo_whatsapp', 'criado_em', 'consentimento_lgpd'])
          && isShortString(data.nome)
          && isShortString(data.orgao)
          && data.email is string && data.email.size() > 5 && data.email.size() <= 254
          && (!('whatsapp' in data) || data.whatsapp == null || (data.whatsapp is string && data.whatsapp.size() <= 30))
          && data.quer_grupo_whatsapp is bool
          && validNivel(data.nivel)
          && data.criado_em == request.time
          && data.consentimento_lgpd.aceito == true
          && data.consentimento_lgpd.versao is string
          && data.consentimento_lgpd.em == request.time;
    }

    function validStatsIncrement(newData, oldData) {
      return newData.total == oldData.total + 1
          && newData.diff(oldData).affectedKeys().hasOnly(['nunca_usei', 'perguntas_simples', 'produzo_conteudo', 'ja_criei', 'total', 'atualizado_em']);
    }

    match /participantes/{id} {
      allow create: if validNewParticipant(request.resource.data);
      allow read, update, delete: if false;
    }

    match /stats/distribuicao {
      allow read: if true;
      allow create: if
          request.resource.data.keys().hasOnly(['nunca_usei', 'perguntas_simples', 'produzo_conteudo', 'ja_criei', 'total', 'atualizado_em'])
          && request.resource.data.total == 1
          && request.resource.data.nunca_usei >= 0
          && request.resource.data.perguntas_simples >= 0
          && request.resource.data.produzo_conteudo >= 0
          && request.resource.data.ja_criei >= 0
          && (request.resource.data.nunca_usei + request.resource.data.perguntas_simples + request.resource.data.produzo_conteudo + request.resource.data.ja_criei) == 1;
      allow update: if validStatsIncrement(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Contador de visitas por secao. Anyone pode incrementar (so total +1);
    // leitura restrita ao admin autenticado (e-mail abaixo).
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'carlacristinesoares@gmail.com';
    }

    function validVisitCreate(data) {
      return data.keys().hasOnly(['total', 'updated_at'])
          && data.total == 1
          && data.updated_at == request.time;
    }

    function validVisitIncrement(newData, oldData) {
      return newData.total == oldData.total + 1
          && newData.updated_at == request.time
          && newData.diff(oldData).affectedKeys().hasOnly(['total', 'updated_at']);
    }

    match /page_visits/{docId} {
      allow read: if isAdmin();
      allow create: if docId in ['home', 'jornada', 'lelia']
                    && validVisitCreate(request.resource.data);
      allow update: if docId in ['home', 'jornada', 'lelia']
                    && validVisitIncrement(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Diagnostico das trilhas. Anonimo: nao guarda PII, so respostas + recomendacao.
    function validTrilhaSlug(s) {
      return s in [
        'fundamental-dados',
        'autonomia-digital',
        'produtividade-automacao',
        'dados-decisao',
        'construcao',
        'programacao',
        'governanca'
      ];
    }

    function validNewDiagnostico(data) {
      return data.keys().hasOnly(['respostas', 'trilha_recomendada', 'aderencia', 'criado_em'])
          && data.keys().hasAll(['respostas', 'trilha_recomendada', 'aderencia', 'criado_em'])
          && data.respostas is map
          && validTrilhaSlug(data.trilha_recomendada)
          && data.aderencia is int
          && data.aderencia >= 0 && data.aderencia <= 100
          && data.criado_em == request.time;
    }

    function validDiagStatsIncrement(newData, oldData) {
      return newData.total == oldData.total + 1
          && newData.diff(oldData).affectedKeys().hasOnly([
              'fundamental-dados',
              'autonomia-digital',
              'produtividade-automacao',
              'dados-decisao',
              'construcao',
              'programacao',
              'governanca',
              'total',
              'atualizado_em'
          ]);
    }

    match /diagnosticos/{id} {
      allow create: if validNewDiagnostico(request.resource.data);
      allow read, update, delete: if false;
    }

    match /stats/diagnostico_distribuicao {
      allow read: if true;
      allow create: if
          request.resource.data.keys().hasOnly([
              'fundamental-dados',
              'autonomia-digital',
              'produtividade-automacao',
              'dados-decisao',
              'construcao',
              'programacao',
              'governanca',
              'total',
              'atualizado_em'
          ])
          && request.resource.data.total == 1;
      allow update: if validDiagStatsIncrement(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Sugestoes de melhoria. Anonimo: qualquer pessoa pode enviar.
    // Leitura restrita ao admin (mesma funcao isAdmin acima).
    function validCategoria(c) {
      return c in ['conteudo', 'erro', 'ideia', 'outro'];
    }

    function validNewSugestao(data) {
      return data.keys().hasAll(['mensagem', 'categoria', 'criado_em'])
          && data.keys().hasOnly(['mensagem', 'categoria', 'contato', 'criado_em'])
          && data.mensagem is string
          && data.mensagem.size() > 0 && data.mensagem.size() <= 2000
          && validCategoria(data.categoria)
          && (!('contato' in data) || data.contato == null
              || (data.contato is string && data.contato.size() <= 200))
          && data.criado_em == request.time;
    }

    match /sugestoes/{id} {
      allow create: if validNewSugestao(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Avaliacoes da oficina "Humanos no Comando". Anonimo: qualquer pessoa
    // pode enviar. Leitura restrita ao admin (mesma funcao isAdmin acima).
    function validNota5(n) {
      return n is int && n >= 1 && n <= 5;
    }

    function validNewAvaliacao(data) {
      return data.keys().hasAll(['nota_geral', 'criado_em'])
          && data.keys().hasOnly(['nota_geral', 'nota_conteudo', 'funcionou',
              'melhorar', 'recomenda', 'assunto_proximo', 'nome', 'orgao', 'criado_em'])
          && validNota5(data.nota_geral)
          && (!('nota_conteudo' in data) || validNota5(data.nota_conteudo))
          && (!('recomenda' in data) || data.recomenda is bool)
          && (!('funcionou' in data) || (data.funcionou is string && data.funcionou.size() <= 2000))
          && (!('melhorar' in data) || (data.melhorar is string && data.melhorar.size() <= 2000))
          && (!('assunto_proximo' in data) || (data.assunto_proximo is string && data.assunto_proximo.size() <= 2000))
          && (!('nome' in data) || (data.nome is string && data.nome.size() <= 200))
          && (!('orgao' in data) || (data.orgao is string && data.orgao.size() <= 200))
          && data.criado_em == request.time;
    }

    match /avaliacoes/{id} {
      allow create: if validNewAvaliacao(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
